[Unit]
Description=Mini Server Dashboard - Web-based system monitoring
After=network.target

[Service]
Type=simple
User=deepuser
WorkingDirectory=/Apps/dashboard
ExecStart=/usr/bin/python3 /Apps/dashboard/server.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=PORT=19090

# Override PORT if a different listener is required.

[Install]
WantedBy=multi-user.target