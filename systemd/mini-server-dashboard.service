[Unit]
Description=Mini Server Dashboard - GPU Training Monitor
After=network.target

[Service]
Type=simple
User=deepuser
WorkingDirectory=/Apps/dashboard
ExecStart=/usr/bin/python3 /Apps/dashboard/app.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target